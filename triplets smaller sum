class Solution {
    int countTriplets(int sum, int arr[]) {
        // code here
        int ans=0;
        Arrays.sort(arr);
        for(int i=0;i<arr.length-2;i++){
            int l=i+1;
            int r=arr.length-1;
            while(l<r){
                int s=arr[i]+arr[l]+arr[r];
                if(s>=sum){
                r--;
                    
                }
                else{
                    ans=ans+(r-l);
                    l++;
            }
            }
        }
        return ans;
    }
}
